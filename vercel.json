{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/", "destination": "/devops", "permanent": false }
  ],
  "rewrites": [
    { "source": "/devops", "destination": "/index.html" },
    { "source": "/devops/ws-thank-you", "destination": "/ws-thank-you.html" },
    { "source": "/devops/ws-thank-you/:path*", "destination": "/ws-thank-you.html" },
    { "source": "/devops/:path*", "destination": "/:path*" }
  ],
  "headers": [
    { "source": "/batch-config.js", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/devops/batch-config.js", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/tracking-config.js", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/devops/tracking-config.js", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/admin.html", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/devops/admin.html", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
